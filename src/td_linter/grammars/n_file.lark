// Lark grammar for TouchDesigner .n (node definition) files
//
// Example:
//   TOP:displace
//   tile 260 200 130 72
//   flags =  viewer 1 parlanguage 0
//   inputs
//   {
//   0 	moviefilein1
//   1 	chopto1
//   }
//   color 0.67 0.67 0.67
//   view -1 3 0 0 1 1 0 0
//   end

// Allow directives in any order after type header
start: type_header directive* END

type_header: FAMILY ":" OP_TYPE

directive: tile_directive
         | flags_directive
         | inputs_block
         | extrainputs_block
         | exports_block
         | color_directive
         | dock_directive
         | view_directive
         | comment_directive
         | v_directive

v_directive: "v" SIGNED_NUMBER SIGNED_NUMBER SIGNED_NUMBER

tile_directive: "tile" SIGNED_INT SIGNED_INT SIGNED_INT SIGNED_INT
flags_directive: "flags" "=" flag_pair*
flag_pair: IDENTIFIER flag_value?
flag_value: SIGNED_INT | IDENTIFIER
comment_directive: "comment" ESCAPED_STRING

inputs_block: "inputs" "{" input_entry* "}"
input_entry: INT OPERATOR_REF

extrainputs_block: "extrainputs" "{" extrainput_entry* "}"
extrainput_entry: INT EXTRAINPUT_REF IDENTIFIER

exports_block: "exports" "{" export_entry* "}"
export_entry: OPERATOR_REF

color_directive: "color" NUMBER NUMBER NUMBER NUMBER?

dock_directive: "dock" IDENTIFIER

view_directive: "view" view_value*
view_value: SIGNED_NUMBER | ESCAPED_STRING | STAR

// Terminals
FAMILY: "TOP" | "CHOP" | "SOP" | "DAT" | "COMP" | "MAT" | "POP"
OP_TYPE: /[a-zA-Z_][a-zA-Z0-9_]*/
OPERATOR_REF: /[a-zA-Z_][a-zA-Z0-9_\/]*/
EXTRAINPUT_REF: /\.\.(?:\/[a-zA-Z_][a-zA-Z0-9_]*)*|[a-zA-Z_][a-zA-Z0-9_]*(?:\/[a-zA-Z_][a-zA-Z0-9_]*)*/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
SIGNED_INT: /-?[0-9]+/
STAR: "*"
END: "end"

%import common.INT
%import common.NUMBER
%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING
%import common.WS
%import common.NEWLINE

%ignore WS
%ignore NEWLINE
