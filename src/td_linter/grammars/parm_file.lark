// Lark grammar for TouchDesigner .parm (parameter) files
//
// Example:
//   ?
//   type 0 hermite
//   rough 0 0.25
//   tx 49 6531 absTime.frame*.6
//   ty 32 0
//   autoexportroot 17 "" me.parent()
//   ?

// Line-oriented format with explicit newline handling
start: DELIMITER _NL param_block DELIMITER _NL?

param_block: (param_line _NL)*

param_line: PARAM_NAME MODE param_value expression?

param_value: SIGNED_NUMBER
           | ESCAPED_STRING
           | PATH_REF
           | GLOB_PATTERN
           | IDENTIFIER

expression: EXPRESSION_TEXT

// Terminals
DELIMITER: "?"
PARAM_NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
MODE: /[0-9]+/
// Paths can be relative (./foo) or absolute (/foo/bar)
PATH_REF: /\.\/[a-zA-Z0-9_\/.-]+/ | /\/[a-zA-Z0-9_\/.-]+/
// Glob patterns like ?* or *foo
GLOB_PATTERN: /[?*][a-zA-Z0-9_?*]+/
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
EXPRESSION_TEXT: /[^\n?]+/

// Newline as significant token (not ignored)
_NL: /\r?\n/

%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING

// Only ignore spaces/tabs within lines
%ignore / +/
%ignore /\t+/
