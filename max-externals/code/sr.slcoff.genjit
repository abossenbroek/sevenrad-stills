					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "newobj",
					"numinlets": 0,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						130.0,
						30.0,
						100.0,
						20.0
					],
					"text": "param fill_mode 0"
				}
			},
			{
				"box": {
					"code": "mask_value = sample(in2, norm).r;\r\n\r\n// If mask < 0.5, pixel is in a gap region\r\nif (mask_value < 0.5) {\r\n    // This is a gap pixel - apply fill mode\r\n    if (fill_mode == 0) {\r\n        // Black fill\r\n        out = vec(0, 0, 0, in1.a);\r\n    } else if (fill_mode == 1) {\r\n        // White fill\r\n        out = vec(1, 1, 1, in1.a);\r\n    } else {\r\n        // Mean fill - sample nearby valid pixels\r\n        // Sample 8 neighbors in a small radius\r\n        pixel_size_x = 1.0 / dim.x;\r\n        pixel_size_y = 1.0 / dim.y;\r\n\r\n        // Sample in a 3x3 pattern around current pixel\r\n        sum_r = 0.0;\r\n        sum_g = 0.0;\r\n        sum_b = 0.0;\r\n        count = 0.0;\r\n\r\n        // Top-left\r\n        offset = vec(-pixel_size_x, -pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Top\r\n        offset = vec(0, -pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Top-right\r\n        offset = vec(pixel_size_x, -pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Left\r\n        offset = vec(-pixel_size_x, 0);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Right\r\n        offset = vec(pixel_size_x, 0);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Bottom-left\r\n        offset = vec(-pixel_size_x, pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Bottom\r\n        offset = vec(0, pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // Bottom-right\r\n        offset = vec(pixel_size_x, pixel_size_y);\r\n        neighbor_mask = sample(in2, norm + offset).r;\r\n        if (neighbor_mask > 0.5) {\r\n            neighbor = sample(in1, norm + offset);\r\n            sum_r += neighbor.r;\r\n            sum_g += neighbor.g;\r\n            sum_b += neighbor.b;\r\n            count += 1.0;\r\n        }\r\n\r\n        // If we found valid neighbors, use their average\r\n        // Otherwise fall back to black\r\n        if (count > 0.0) {\r\n            out = vec(sum_r / count, sum_g / count, sum_b / count, in1.a);\r\n        } else {\r\n            out = vec(0, 0, 0, in1.a);\r\n        }\r\n    }\r\n} else {\r\n    // Valid pixel region, pass through unchanged\r\n    out = in1;\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-4",
					"maxclass": "codebox",
