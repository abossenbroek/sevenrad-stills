					"text": "param method 0"
				}
			},
			{
				"box": {
					"code": "/*\r\n * sr.downscale.genjit\r\n *\r\n * Pixelation and downscale effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   scale (float 0.01-1.0): Scale factor, lower = more pixelated (default: 0.5)\r\n *   pixelate (int 0-1): 1 = pixelate mode, 0 = downscale mode (default: 1)\r\n *   method (int 0-1): 0 = nearest neighbor, 1 = bilinear (default: 0)\r\n *\r\n * Modes:\r\n *   Pixelate: Quantizes to lower resolution grid, creates blocky pixels\r\n *   Downscale: Scales coordinates, shrinks image\r\n *\r\n * Source: Python downscale implementation\r\n */\r\n\r\n// Clamp scale to valid range\r\ns = clamp(scale, 0.01, 1.0);\r\n\r\n// Calculate pixel size for quantization\r\npixel_size = 1.0 / s;\r\n\r\n// Determine sampling coordinate based on mode\r\nif (pixelate > 0.5) {\r\n    // Pixelate mode: quantize to lower resolution grid\r\n    // Floor to pixel boundaries, then add half pixel offset for center\r\n    coord_x = (floor(norm.x * dim.x / pixel_size) * pixel_size + pixel_size * 0.5) / dim.x;\r\n    coord_y = (floor(norm.y * dim.y / pixel_size) * pixel_size + pixel_size * 0.5) / dim.y;\r\n    coord = vec(coord_x, coord_y);\r\n} else {\r\n    // Downscale mode: scale coordinates directly\r\n    coord = norm * s;\r\n}\r\n\r\n// Clamp coordinates to valid range\r\ncoord = clamp(coord, vec(0, 0), vec(1, 1));\r\n\r\n// Sample with selected method\r\n// Note: GenExpr sample() uses bilinear by default\r\n// For nearest neighbor, we floor to pixel center\r\nif (method < 0.5) {\r\n    // Nearest neighbor: floor to pixel center\r\n    px = floor(coord.x * dim.x) + 0.5;\r\n    py = floor(coord.y * dim.y) + 0.5;\r\n    out1 = sample(in1, vec(px / dim.x, py / dim.y));\r\n} else {\r\n    // Bilinear: use coordinate directly\r\n    out1 = sample(in1, coord);\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-5",
					"maxclass": "codebox",
