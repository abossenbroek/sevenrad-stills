					"text": "in 1"
				}
			},
			{
				"box": {
					"code": "<jit.gl.pix>\r\n<description>Pixelation and downscale effect</description>\r\n\r\n<param name=\"scale\" type=\"float\" default=\"0.5\" />\r\n<param name=\"pixelate\" type=\"int\" default=\"1\" />\r\n<param name=\"method\" type=\"int\" default=\"0\" />\r\n\r\n<language name=\"glsl\" version=\"1.2\">\r\n<bind param=\"scale\" program=\"fp\" />\r\n<bind param=\"pixelate\" program=\"fp\" />\r\n<bind param=\"method\" program=\"fp\" />\r\n\r\n<program name=\"fp\" type=\"fragment\">\r\n<![CDATA[\r\n\r\n#version 120\r\n\r\nuniform sampler2DRect tex0;\r\nuniform vec2 texdim0;\r\nuniform float scale;\r\nuniform float pixelate;\r\nuniform float method;\r\n\r\nvarying vec2 texcoord0;\r\n\r\nvoid main() {\r\n    // Clamp scale to valid range\r\n    float s = clamp(scale, 0.01, 1.0);\r\n\r\n    vec2 coord;\r\n\r\n    if (pixelate > 0.5) {\r\n        // Pixelate mode: quantize to lower resolution then scale back up\r\n        // Calculate pixel size in original resolution\r\n        vec2 pixel_size = vec2(1.0 / s);\r\n\r\n        // Quantize coordinates to pixel grid\r\n        coord = floor(texcoord0 / pixel_size) * pixel_size;\r\n\r\n        // Add half pixel offset for center sampling\r\n        if (method < 0.5) {\r\n            // Nearest neighbor: sample from pixel center\r\n            coord += pixel_size * 0.5;\r\n        } else {\r\n            // Bilinear: sample from pixel center but let texture filtering handle it\r\n            coord += pixel_size * 0.5;\r\n        }\r\n    } else {\r\n        // Actual downscale mode: scale coordinates\r\n        coord = texcoord0 * s;\r\n    }\r\n\r\n    // Clamp coordinates to texture bounds\r\n    coord = clamp(coord, vec2(0.0), texdim0 - vec2(1.0));\r\n\r\n    // Sample texture\r\n    if (method < 0.5) {\r\n        // Nearest neighbor sampling\r\n        gl_FragColor = texture2DRect(tex0, floor(coord) + vec2(0.5));\r\n    } else {\r\n        // Bilinear sampling (hardware filtering)\r\n        gl_FragColor = texture2DRect(tex0, coord);\r\n    }\r\n}\r\n\r\n]]>\r\n</program>\r\n</language>\r\n</jit.gl.pix>",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-2",
