					"text": "param method 0 0 1"
				}
			},
			{
				"box": {
					"code": "/*\n * sr.downscale.genjit\n *\n * Pixelation and downscale effect\n * Part of SevenRad Max 8 Effects\n *\n * Parameters:\n *   scale (float 0.01-1.0): Scale factor, lower = more pixelated (default: 0.5)\n *   pixelate (int 0-1): 1 = pixelate mode, 0 = downscale mode (default: 1)\n *   method (int 0-1): 0 = nearest neighbor, 1 = bilinear (default: 0)\n *\n * Modes:\n *   Pixelate: Quantizes to lower resolution grid, creates blocky pixels\n *   Downscale: Scales coordinates, shrinks image\n *\n * Source: Python downscale implementation\n */\n\n// Clamp scale to valid range\ns = clamp(scale, 0.01, 1.0);\n\n// Calculate pixel size for quantization\npixel_size = 1.0 / s;\n\n// Initialize coord in outer scope (GenExpr uses strict block scoping)\ncoord = vec(0, 0);\n\n// Determine sampling coordinate based on mode\nif (pixelate > 0.5) {\n    // Pixelate mode: quantize to lower resolution grid\n    // Floor to pixel boundaries, then add half pixel offset for center\n    coord_x = (floor(norm.x * dim.x / pixel_size) * pixel_size + pixel_size * 0.5) / dim.x;\n    coord_y = (floor(norm.y * dim.y / pixel_size) * pixel_size + pixel_size * 0.5) / dim.y;\n    coord = vec(coord_x, coord_y);\n} else {\n    // Downscale mode: scale coordinates directly\n    coord = norm * s;\n}\n\n// Clamp coordinates to valid range\ncoord = clamp(coord, vec(0, 0), vec(1, 1));\n\n// Sample with selected method\n// Note: GenExpr sample() uses bilinear by default\n// For nearest neighbor, we floor to pixel center\nif (method < 0.5) {\n    // Nearest neighbor: floor to pixel center\n    px = floor(coord.x * dim.x) + 0.5;\n    py = floor(coord.y * dim.y) + 0.5;\n    out1 = sample(in1, vec(px / dim.x, py / dim.y));\n} else {\n    // Bilinear: use coordinate directly\n    out1 = sample(in1, coord);\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-5",
					"maxclass": "codebox",
