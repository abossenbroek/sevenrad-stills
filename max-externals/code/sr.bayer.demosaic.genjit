			{
				"box": {
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-2",
					"maxclass": "newobj",
					"numinlets": 0,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						130.0,
						30.0,
						100.0,
						20.0
					],
					"text": "param pattern 0"
				}
			},
			{
				"box": {
					"code": "px = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Determine position in 2x2 Bayer pattern\r\ncx = px % 2;\r\ncy = py % 2;\r\n\r\n// Determine which channel is known at this position\r\n// 0=R, 1=G, 2=B\r\nchannel_type = 0;\r\n\r\nif (pattern == 0) {  // RGGB\r\n    if (cy == 0 && cx == 0) {\r\n        channel_type = 0;  // R\r\n    } else if (cy == 0 && cx == 1) {\r\n        channel_type = 1;  // G\r\n    } else if (cy == 1 && cx == 0) {\r\n        channel_type = 1;  // G\r\n    } else {\r\n        channel_type = 2;  // B\r\n    }\r\n} else if (pattern == 1) {  // BGGR\r\n    if (cy == 0 && cx == 0) {\r\n        channel_type = 2;  // B\r\n    } else if (cy == 0 && cx == 1) {\r\n        channel_type = 1;  // G\r\n    } else if (cy == 1 && cx == 0) {\r\n        channel_type = 1;  // G\r\n    } else {\r\n        channel_type = 0;  // R\r\n    }\r\n} else if (pattern == 2) {  // GRBG\r\n    if (cy == 0 && cx == 0) {\r\n        channel_type = 1;  // G\r\n    } else if (cy == 0 && cx == 1) {\r\n        channel_type = 0;  // R\r\n    } else if (cy == 1 && cx == 0) {\r\n        channel_type = 2;  // B\r\n    } else {\r\n        channel_type = 1;  // G\r\n    }\r\n} else {  // GBRG (pattern == 3)\r\n    if (cy == 0 && cx == 0) {\r\n        channel_type = 1;  // G\r\n    } else if (cy == 0 && cx == 1) {\r\n        channel_type = 2;  // B\r\n    } else if (cy == 1 && cx == 0) {\r\n        channel_type = 0;  // R\r\n    } else {\r\n        channel_type = 1;  // G\r\n    }\r\n}\r\n\r\n// Get the known value at current position (from mosaic - stored in .r channel)\r\nvalue_center = in1.r;\r\n\r\n// Initialize output channels\r\nr_out = 0.0;\r\ng_out = 0.0;\r\nb_out = 0.0;\r\n\r\n// Pixel step in normalized coordinates\r\nstep_x = 1.0 / dim.x;\r\nstep_y = 1.0 / dim.y;\r\n\r\n// R position: R known, interpolate G and B\r\nif (channel_type == 0) {\r\n    r_out = value_center;\r\n\r\n    // Interpolate G from 4 cross neighbors (up, down, left, right)\r\n    g_sum = 0.0;\r\n    g_count = 0.0;\r\n\r\n    // Up\r\n    if (py > 0) {\r\n        g_sum += sample(in1, norm + vec(0, -step_y)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Down\r\n    if (py < dim.y - 1) {\r\n        g_sum += sample(in1, norm + vec(0, step_y)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Left\r\n    if (px > 0) {\r\n        g_sum += sample(in1, norm + vec(-step_x, 0)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Right\r\n    if (px < dim.x - 1) {\r\n        g_sum += sample(in1, norm + vec(step_x, 0)).r;\r\n        g_count += 1.0;\r\n    }\r\n\r\n    g_out = (g_count > 0) ? (g_sum / g_count) : 0.0;\r\n\r\n    // Interpolate B from 4 diagonal neighbors\r\n    b_sum = 0.0;\r\n    b_count = 0.0;\r\n\r\n    // Top-left\r\n    if (py > 0 && px > 0) {\r\n        b_sum += sample(in1, norm + vec(-step_x, -step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n    // Top-right\r\n    if (py > 0 && px < dim.x - 1) {\r\n        b_sum += sample(in1, norm + vec(step_x, -step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n    // Bottom-left\r\n    if (py < dim.y - 1 && px > 0) {\r\n        b_sum += sample(in1, norm + vec(-step_x, step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n    // Bottom-right\r\n    if (py < dim.y - 1 && px < dim.x - 1) {\r\n        b_sum += sample(in1, norm + vec(step_x, step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n\r\n    b_out = (b_count > 0) ? (b_sum / b_count) : 0.0;\r\n}\r\n// G position: G known, interpolate R and B\r\nelse if (channel_type == 1) {\r\n    g_out = value_center;\r\n\r\n    // Interpolate R from horizontal neighbors first, vertical if not available\r\n    r_sum = 0.0;\r\n    r_count = 0.0;\r\n\r\n    // Try horizontal neighbors\r\n    if (px > 0) {\r\n        r_sum += sample(in1, norm + vec(-step_x, 0)).r;\r\n        r_count += 1.0;\r\n    }\r\n    if (px < dim.x - 1) {\r\n        r_sum += sample(in1, norm + vec(step_x, 0)).r;\r\n        r_count += 1.0;\r\n    }\r\n\r\n    // If no horizontal neighbors, try vertical\r\n    if (r_count == 0) {\r\n        if (py > 0) {\r\n            r_sum += sample(in1, norm + vec(0, -step_y)).r;\r\n            r_count += 1.0;\r\n        }\r\n        if (py < dim.y - 1) {\r\n            r_sum += sample(in1, norm + vec(0, step_y)).r;\r\n            r_count += 1.0;\r\n        }\r\n    }\r\n\r\n    r_out = (r_count > 0) ? (r_sum / r_count) : 0.0;\r\n\r\n    // Interpolate B from vertical neighbors first, horizontal if not available\r\n    b_sum = 0.0;\r\n    b_count = 0.0;\r\n\r\n    // Try vertical neighbors\r\n    if (py > 0) {\r\n        b_sum += sample(in1, norm + vec(0, -step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n    if (py < dim.y - 1) {\r\n        b_sum += sample(in1, norm + vec(0, step_y)).r;\r\n        b_count += 1.0;\r\n    }\r\n\r\n    // If no vertical neighbors, try horizontal\r\n    if (b_count == 0) {\r\n        if (px > 0) {\r\n            b_sum += sample(in1, norm + vec(-step_x, 0)).r;\r\n            b_count += 1.0;\r\n        }\r\n        if (px < dim.x - 1) {\r\n            b_sum += sample(in1, norm + vec(step_x, 0)).r;\r\n            b_count += 1.0;\r\n        }\r\n    }\r\n\r\n    b_out = (b_count > 0) ? (b_sum / b_count) : 0.0;\r\n}\r\n// B position: B known, interpolate G and R\r\nelse {  // channel_type == 2\r\n    b_out = value_center;\r\n\r\n    // Interpolate G from 4 cross neighbors\r\n    g_sum = 0.0;\r\n    g_count = 0.0;\r\n\r\n    // Up\r\n    if (py > 0) {\r\n        g_sum += sample(in1, norm + vec(0, -step_y)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Down\r\n    if (py < dim.y - 1) {\r\n        g_sum += sample(in1, norm + vec(0, step_y)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Left\r\n    if (px > 0) {\r\n        g_sum += sample(in1, norm + vec(-step_x, 0)).r;\r\n        g_count += 1.0;\r\n    }\r\n    // Right\r\n    if (px < dim.x - 1) {\r\n        g_sum += sample(in1, norm + vec(step_x, 0)).r;\r\n        g_count += 1.0;\r\n    }\r\n\r\n    g_out = (g_count > 0) ? (g_sum / g_count) : 0.0;\r\n\r\n    // Interpolate R from 4 diagonal neighbors\r\n    r_sum = 0.0;\r\n    r_count = 0.0;\r\n\r\n    // Top-left\r\n    if (py > 0 && px > 0) {\r\n        r_sum += sample(in1, norm + vec(-step_x, -step_y)).r;\r\n        r_count += 1.0;\r\n    }\r\n    // Top-right\r\n    if (py > 0 && px < dim.x - 1) {\r\n        r_sum += sample(in1, norm + vec(step_x, -step_y)).r;\r\n        r_count += 1.0;\r\n    }\r\n    // Bottom-left\r\n    if (py < dim.y - 1 && px > 0) {\r\n        r_sum += sample(in1, norm + vec(-step_x, step_y)).r;\r\n        r_count += 1.0;\r\n    }\r\n    // Bottom-right\r\n    if (py < dim.y - 1 && px < dim.x - 1) {\r\n        r_sum += sample(in1, norm + vec(step_x, step_y)).r;\r\n        r_count += 1.0;\r\n    }\r\n\r\n    r_out = (r_count > 0) ? (r_sum / r_count) : 0.0;\r\n}\r\n\r\n// Clamp and output reconstructed RGB\r\nout1 = vec(clamp(r_out, 0, 1), clamp(g_out, 0, 1), clamp(b_out, 0, 1), 1.0);",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "codebox",
					"numinlets": 1,
					"numoutlets": 1,
					"outlettype": [
