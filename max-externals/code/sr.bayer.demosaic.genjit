			},
			{
				"box": {
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-2",
					"maxclass": "newobj",
					"numinlets": 0,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						130.0,
						30.0,
						100.0,
						20.0
					],
					"text": "param pattern 0 0 3"
				}
			},
			{
				"box": {
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-scale",
					"maxclass": "newobj",
					"numinlets": 0,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						250.0,
						30.0,
						100.0,
						20.0
					],
					"text": "param scale 1 1 20"
				}
			},
			{
				"box": {
					"code": "// Scale factor for Bayer pattern (1 = normal, higher = larger blocks)\nscale_int = max(1, int(scale));\nscale_f = float(scale_int);\n\npx = int(norm.x * dim.x);\npy = int(norm.y * dim.y);\n\n// Determine position in 2x2 Bayer pattern (scaled)\ncx = (px / scale_int) % 2;\ncy = (py / scale_int) % 2;\n\n// Determine which channel is known at this position\n// 0=R, 1=G, 2=B\nchannel_type = 0;\n\nif (pattern == 0) {  // RGGB\n    if (cy == 0 && cx == 0) {\n        channel_type = 0;  // R\n    } else if (cy == 0 && cx == 1) {\n        channel_type = 1;  // G\n    } else if (cy == 1 && cx == 0) {\n        channel_type = 1;  // G\n    } else {\n        channel_type = 2;  // B\n    }\n} else if (pattern == 1) {  // BGGR\n    if (cy == 0 && cx == 0) {\n        channel_type = 2;  // B\n    } else if (cy == 0 && cx == 1) {\n        channel_type = 1;  // G\n    } else if (cy == 1 && cx == 0) {\n        channel_type = 1;  // G\n    } else {\n        channel_type = 0;  // R\n    }\n} else if (pattern == 2) {  // GRBG\n    if (cy == 0 && cx == 0) {\n        channel_type = 1;  // G\n    } else if (cy == 0 && cx == 1) {\n        channel_type = 0;  // R\n    } else if (cy == 1 && cx == 0) {\n        channel_type = 2;  // B\n    } else {\n        channel_type = 1;  // G\n    }\n} else {  // GBRG (pattern == 3)\n    if (cy == 0 && cx == 0) {\n        channel_type = 1;  // G\n    } else if (cy == 0 && cx == 1) {\n        channel_type = 2;  // B\n    } else if (cy == 1 && cx == 0) {\n        channel_type = 0;  // R\n    } else {\n        channel_type = 1;  // G\n    }\n}\n\n// Get the known value at current position (from mosaic - stored in .r channel)\nvalue_center = in1.r;\n\n// Initialize output channels\nr_out = 0.0;\ng_out = 0.0;\nb_out = 0.0;\n\n// Pixel step in normalized coordinates (scaled for larger blocks)\nstep_x = scale_f / dim.x;\nstep_y = scale_f / dim.y;\n\n// R position: R known, interpolate G and B\nif (channel_type == 0) {\n    r_out = value_center;\n\n    // Interpolate G from 4 cross neighbors (up, down, left, right)\n    g_sum = 0.0;\n    g_count = 0.0;\n\n    // Up\n    if (py >= scale_int) {\n        g_sum += sample(in1, norm + vec(0, -step_y)).r;\n        g_count += 1.0;\n    }\n    // Down\n    if (py < dim.y - scale_int) {\n        g_sum += sample(in1, norm + vec(0, step_y)).r;\n        g_count += 1.0;\n    }\n    // Left\n    if (px >= scale_int) {\n        g_sum += sample(in1, norm + vec(-step_x, 0)).r;\n        g_count += 1.0;\n    }\n    // Right\n    if (px < dim.x - scale_int) {\n        g_sum += sample(in1, norm + vec(step_x, 0)).r;\n        g_count += 1.0;\n    }\n\n    g_out = (g_count > 0) ? (g_sum / g_count) : 0.0;\n\n    // Interpolate B from 4 diagonal neighbors\n    b_sum = 0.0;\n    b_count = 0.0;\n\n    // Top-left\n    if (py >= scale_int && px >= scale_int) {\n        b_sum += sample(in1, norm + vec(-step_x, -step_y)).r;\n        b_count += 1.0;\n    }\n    // Top-right\n    if (py >= scale_int && px < dim.x - scale_int) {\n        b_sum += sample(in1, norm + vec(step_x, -step_y)).r;\n        b_count += 1.0;\n    }\n    // Bottom-left\n    if (py < dim.y - scale_int && px >= scale_int) {\n        b_sum += sample(in1, norm + vec(-step_x, step_y)).r;\n        b_count += 1.0;\n    }\n    // Bottom-right\n    if (py < dim.y - scale_int && px < dim.x - scale_int) {\n        b_sum += sample(in1, norm + vec(step_x, step_y)).r;\n        b_count += 1.0;\n    }\n\n    b_out = (b_count > 0) ? (b_sum / b_count) : 0.0;\n}\n// G position: G known, interpolate R and B\nelse if (channel_type == 1) {\n    g_out = value_center;\n\n    // Interpolate R from horizontal neighbors first, vertical if not available\n    r_sum = 0.0;\n    r_count = 0.0;\n\n    // Try horizontal neighbors\n    if (px >= scale_int) {\n        r_sum += sample(in1, norm + vec(-step_x, 0)).r;\n        r_count += 1.0;\n    }\n    if (px < dim.x - scale_int) {\n        r_sum += sample(in1, norm + vec(step_x, 0)).r;\n        r_count += 1.0;\n    }\n\n    // If no horizontal neighbors, try vertical\n    if (r_count == 0) {\n        if (py >= scale_int) {\n            r_sum += sample(in1, norm + vec(0, -step_y)).r;\n            r_count += 1.0;\n        }\n        if (py < dim.y - scale_int) {\n            r_sum += sample(in1, norm + vec(0, step_y)).r;\n            r_count += 1.0;\n        }\n    }\n\n    r_out = (r_count > 0) ? (r_sum / r_count) : 0.0;\n\n    // Interpolate B from vertical neighbors first, horizontal if not available\n    b_sum = 0.0;\n    b_count = 0.0;\n\n    // Try vertical neighbors\n    if (py >= scale_int) {\n        b_sum += sample(in1, norm + vec(0, -step_y)).r;\n        b_count += 1.0;\n    }\n    if (py < dim.y - scale_int) {\n        b_sum += sample(in1, norm + vec(0, step_y)).r;\n        b_count += 1.0;\n    }\n\n    // If no vertical neighbors, try horizontal\n    if (b_count == 0) {\n        if (px >= scale_int) {\n            b_sum += sample(in1, norm + vec(-step_x, 0)).r;\n            b_count += 1.0;\n        }\n        if (px < dim.x - scale_int) {\n            b_sum += sample(in1, norm + vec(step_x, 0)).r;\n            b_count += 1.0;\n        }\n    }\n\n    b_out = (b_count > 0) ? (b_sum / b_count) : 0.0;\n}\n// B position: B known, interpolate G and R\nelse {  // channel_type == 2\n    b_out = value_center;\n\n    // Interpolate G from 4 cross neighbors\n    g_sum = 0.0;\n    g_count = 0.0;\n\n    // Up\n    if (py >= scale_int) {\n        g_sum += sample(in1, norm + vec(0, -step_y)).r;\n        g_count += 1.0;\n    }\n    // Down\n    if (py < dim.y - scale_int) {\n        g_sum += sample(in1, norm + vec(0, step_y)).r;\n        g_count += 1.0;\n    }\n    // Left\n    if (px >= scale_int) {\n        g_sum += sample(in1, norm + vec(-step_x, 0)).r;\n        g_count += 1.0;\n    }\n    // Right\n    if (px < dim.x - scale_int) {\n        g_sum += sample(in1, norm + vec(step_x, 0)).r;\n        g_count += 1.0;\n    }\n\n    g_out = (g_count > 0) ? (g_sum / g_count) : 0.0;\n\n    // Interpolate R from 4 diagonal neighbors\n    r_sum = 0.0;\n    r_count = 0.0;\n\n    // Top-left\n    if (py >= scale_int && px >= scale_int) {\n        r_sum += sample(in1, norm + vec(-step_x, -step_y)).r;\n        r_count += 1.0;\n    }\n    // Top-right\n    if (py >= scale_int && px < dim.x - scale_int) {\n        r_sum += sample(in1, norm + vec(step_x, -step_y)).r;\n        r_count += 1.0;\n    }\n    // Bottom-left\n    if (py < dim.y - scale_int && px >= scale_int) {\n        r_sum += sample(in1, norm + vec(-step_x, step_y)).r;\n        r_count += 1.0;\n    }\n    // Bottom-right\n    if (py < dim.y - scale_int && px < dim.x - scale_int) {\n        r_sum += sample(in1, norm + vec(step_x, step_y)).r;\n        r_count += 1.0;\n    }\n\n    r_out = (r_count > 0) ? (r_sum / r_count) : 0.0;\n}\n\n// Clamp and output reconstructed RGB\nout1 = vec(clamp(r_out, 0, 1), clamp(g_out, 0, 1), clamp(b_out, 0, 1), 1.0);",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "codebox",
					"numinlets": 1,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						50.0,
						120.0,
						500.0,
						400.0
					]
				}
			},
