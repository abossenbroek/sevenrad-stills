					],
					"text": "param seed 0"
				}
			},
			{
				"box": {
					"code": "/*\r\n * sr.corruption.genjit\r\n *\r\n * Tile-based corruption effect with multiple modes\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Inputs:\r\n *   in1: Source image\r\n *   in2: Tile mask (white = corrupt, black = pass through)\r\n *\r\n * Parameters:\r\n *   mode (int 0-2): 0 = XOR noise, 1 = invert, 2 = channel shuffle (default: 0)\r\n *   intensity (float 0-1): Effect strength (default: 0.5)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Source: src/sevenrad_stills/operations/corruption_taichi.py\r\n */\r\n\r\n// PCG hash constants (must match Python/Taichi)\r\nPCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\n\r\n// Sample tile mask from second input\r\nmask_value = sample(in2, norm).r;\r\n\r\n// Get integer pixel coordinates for hash\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// If mask value > 0.5, this pixel is in a corrupted tile region\r\nif (mask_value > 0.5) {\r\n    // Read original RGB channels\r\n    r = in1.r;\r\n    g = in1.g;\r\n    b = in1.b;\r\n\r\n    if (mode == 0) {\r\n        // XOR mode - mix with random noise pattern\r\n        // Inline rand_pixel for red channel (seed)\r\n        combined_r = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed);\r\n        state_r = int((uint(combined_r) * uint(PCG_MULT) + uint(PCG_INC)));\r\n        word_r = int(((state_r >> ((state_r >> 28) + 4)) ^ state_r) * uint(PCG_FACTOR));\r\n        hash_r = (word_r >> 22) ^ word_r;\r\n        rand_r = float(uint(hash_r)) / UINT32_MAX;\r\n\r\n        // Inline rand_pixel for green channel (seed + 1)\r\n        combined_g = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 1);\r\n        state_g = int((uint(combined_g) * uint(PCG_MULT) + uint(PCG_INC)));\r\n        word_g = int(((state_g >> ((state_g >> 28) + 4)) ^ state_g) * uint(PCG_FACTOR));\r\n        hash_g = (word_g >> 22) ^ word_g;\r\n        rand_g = float(uint(hash_g)) / UINT32_MAX;\r\n\r\n        // Inline rand_pixel for blue channel (seed + 2)\r\n        combined_b = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 2);\r\n        state_b = int((uint(combined_b) * uint(PCG_MULT) + uint(PCG_INC)));\r\n        word_b = int(((state_b >> ((state_b >> 28) + 4)) ^ state_b) * uint(PCG_FACTOR));\r\n        hash_b = (word_b >> 22) ^ word_b;\r\n        rand_b = float(uint(hash_b)) / UINT32_MAX;\r\n\r\n        // Convert to [0-255] range, apply XOR-like operation\r\n        r_int = int(r * 255.0);\r\n        g_int = int(g * 255.0);\r\n        b_int = int(b * 255.0);\r\n\r\n        // Generate XOR masks based on intensity\r\n        xor_mask_r = int(rand_r * 255.0 * intensity);\r\n        xor_mask_g = int(rand_g * 255.0 * intensity);\r\n        xor_mask_b = int(rand_b * 255.0 * intensity);\r\n\r\n        // Simulate XOR by flipping bits proportional to mask\r\n        r_corrupted = float(abs(r_int - xor_mask_r) % 256) / 255.0;\r\n        g_corrupted = float(abs(g_int - xor_mask_g) % 256) / 255.0;\r\n        b_corrupted = float(abs(b_int - xor_mask_b) % 256) / 255.0;\r\n\r\n        out1 = vec(r_corrupted, g_corrupted, b_corrupted, in1.a);\r\n\r\n    } else if (mode == 1) {\r\n        // Invert mode - blend with inverted colors based on intensity\r\n        r_inv = 1.0 - r;\r\n        g_inv = 1.0 - g;\r\n        b_inv = 1.0 - b;\r\n\r\n        r_out = r * (1.0 - intensity) + r_inv * intensity;\r\n        g_out = g * (1.0 - intensity) + g_inv * intensity;\r\n        b_out = b * (1.0 - intensity) + b_inv * intensity;\r\n\r\n        out1 = vec(r_out, g_out, b_out, in1.a);\r\n\r\n    } else {\r\n        // Shuffle mode - random channel permutation per pixel\r\n        // Inline rand_pixel for permutation decision (seed)\r\n        combined_p = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed);\r\n        state_p = int((uint(combined_p) * uint(PCG_MULT) + uint(PCG_INC)));\r\n        word_p = int(((state_p >> ((state_p >> 28) + 4)) ^ state_p) * uint(PCG_FACTOR));\r\n        hash_p = (word_p >> 22) ^ word_p;\r\n        rand_perm = float(uint(hash_p)) / UINT32_MAX;\r\n\r\n        // Only shuffle if random value < intensity\r\n        if (rand_perm < intensity) {\r\n            // Inline rand_pixel for permutation index (seed + 100)\r\n            combined_i = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 100);\r\n            state_i = int((uint(combined_i) * uint(PCG_MULT) + uint(PCG_INC)));\r\n            word_i = int(((state_i >> ((state_i >> 28) + 4)) ^ state_i) * uint(PCG_FACTOR));\r\n            hash_i = (word_i >> 22) ^ word_i;\r\n            rand_idx = float(uint(hash_i)) / UINT32_MAX;\r\n            perm_idx = int(rand_idx * 6.0) % 6;\r\n\r\n            // Apply permutation based on index\r\n            if (perm_idx == 0) {\r\n                // RGB (no change)\r\n                out1 = vec(r, g, b, in1.a);\r\n            } else if (perm_idx == 1) {\r\n                // RBG\r\n                out1 = vec(r, b, g, in1.a);\r\n            } else if (perm_idx == 2) {\r\n                // GRB\r\n                out1 = vec(g, r, b, in1.a);\r\n            } else if (perm_idx == 3) {\r\n                // GBR\r\n                out1 = vec(g, b, r, in1.a);\r\n            } else if (perm_idx == 4) {\r\n                // BRG\r\n                out1 = vec(b, r, g, in1.a);\r\n            } else {\r\n                // BGR\r\n                out1 = vec(b, g, r, in1.a);\r\n            }\r\n        } else {\r\n            // Don't shuffle this pixel\r\n            out1 = vec(r, g, b, in1.a);\r\n        }\r\n    }\r\n}",
					"fontname": "Arial",
