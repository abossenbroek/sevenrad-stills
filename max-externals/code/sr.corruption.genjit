			},
			{
				"box": {
					"code": "PCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\n\r\n/**\r\n * PCG-derived hash function for generating pseudo-random values.\r\n *\r\n * @param input_seed Input seed value to hash\r\n * @return Hashed value as float in range [0.0, 1.0)\r\n */\r\npcg_hash(input_seed) {\r\n    state = int((uint(input_seed) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word = int(((state >> ((state >> 28) + 4)) ^ state) * uint(PCG_FACTOR));\r\n    hash_out = (word >> 22) ^ word;\r\n    return float(uint(hash_out)) / UINT32_MAX;\r\n}\r\n\r\n/**\r\n * Generate deterministic random float based on coordinates and seed.\r\n *\r\n * @param x X coordinate (column)\r\n * @param y Y coordinate (row)\r\n * @param s Random seed\r\n * @return Uniform random float in range [0.0, 1.0)\r\n */\r\nrand_pixel(x, y, s) {\r\n    combined = uint(x) * uint(COORD_PRIME_X) + uint(y) * uint(COORD_PRIME_Y) + uint(s);\r\n    return pcg_hash(combined);\r\n}\r\n\r\n// Sample tile mask from second input\r\nmask_value = sample(in2, norm).r;\r\n\r\n// Get integer pixel coordinates for hash\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// If mask value > 0.5, this pixel is in a corrupted tile region\r\nif (mask_value > 0.5) {\r\n    // Read original RGB channels\r\n    r = in1.r;\r\n    g = in1.g;\r\n    b = in1.b;\r\n\r\n    if (mode == 0) {\r\n        // XOR mode - mix with random noise pattern\r\n        // Generate random values for each channel\r\n        rand_r = rand_pixel(px, py, seed);\r\n        rand_g = rand_pixel(px, py, seed + 1);\r\n        rand_b = rand_pixel(px, py, seed + 2);\r\n\r\n        // Convert to [0-255] range, apply XOR-like operation\r\n        r_int = int(r * 255.0);\r\n        g_int = int(g * 255.0);\r\n        b_int = int(b * 255.0);\r\n\r\n        // Generate XOR masks based on intensity\r\n        xor_mask_r = int(rand_r * 255.0 * intensity);\r\n        xor_mask_g = int(rand_g * 255.0 * intensity);\r\n        xor_mask_b = int(rand_b * 255.0 * intensity);\r\n\r\n        // Simulate XOR by flipping bits proportional to mask\r\n        r_corrupted = float(abs(r_int - xor_mask_r) % 256) / 255.0;\r\n        g_corrupted = float(abs(g_int - xor_mask_g) % 256) / 255.0;\r\n        b_corrupted = float(abs(b_int - xor_mask_b) % 256) / 255.0;\r\n\r\n        out1 = vec(r_corrupted, g_corrupted, b_corrupted, in1.a);\r\n\r\n    } else if (mode == 1) {\r\n        // Invert mode - blend with inverted colors based on intensity\r\n        r_inv = 1.0 - r;\r\n        g_inv = 1.0 - g;\r\n        b_inv = 1.0 - b;\r\n\r\n        r_out = r * (1.0 - intensity) + r_inv * intensity;\r\n        g_out = g * (1.0 - intensity) + g_inv * intensity;\r\n        b_out = b * (1.0 - intensity) + b_inv * intensity;\r\n\r\n        out1 = vec(r_out, g_out, b_out, in1.a);\r\n\r\n    } else {\r\n        // Shuffle mode - random channel permutation per pixel\r\n        // Generate random value to determine permutation\r\n        rand_perm = rand_pixel(px, py, seed);\r\n\r\n        // Only shuffle if random value < intensity\r\n        if (rand_perm < intensity) {\r\n            // Generate permutation index (0-5 for 6 possible permutations)\r\n            perm_idx = int(rand_pixel(px, py, seed + 100) * 6.0) % 6;\r\n\r\n            // Apply permutation based on index\r\n            if (perm_idx == 0) {\r\n                // RGB (no change)\r\n                out1 = vec(r, g, b, in1.a);\r\n            } else if (perm_idx == 1) {\r\n                // RBG\r\n                out1 = vec(r, b, g, in1.a);\r\n            } else if (perm_idx == 2) {\r\n                // GRB\r\n                out1 = vec(g, r, b, in1.a);\r\n            } else if (perm_idx == 3) {\r\n                // GBR\r\n                out1 = vec(g, b, r, in1.a);\r\n            } else if (perm_idx == 4) {\r\n                // BRG\r\n                out1 = vec(b, r, g, in1.a);\r\n            } else {\r\n                // BGR\r\n                out1 = vec(b, g, r, in1.a);\r\n            }\r\n        } else {\r\n            // Don't shuffle this pixel\r\n            out1 = vec(r, g, b, in1.a);\r\n        }\r\n    }\r\n}",
