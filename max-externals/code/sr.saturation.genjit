					"text": "param factor 1.0 0 3"
				}
			},
			{
				"box": {
					"code": "EPSILON = 0.000001;\r\nHUE_SECTOR_0 = 60.0;\r\nHUE_SECTOR_1 = 120.0;\r\nHUE_SECTOR_2 = 180.0;\r\nHUE_SECTOR_3 = 240.0;\r\nHUE_SECTOR_4 = 300.0;\r\nHUE_SECTORS = 6.0;\r\n\r\n// Read input pixel\r\nr = in1.r;\r\ng = in1.g;\r\nb = in1.b;\r\na = in1.a;\r\n\r\n// RGB to HSV conversion\r\ncmax = max(max(r, g), b);\r\ncmin = min(min(r, g), b);\r\ndelta = cmax - cmin;\r\n\r\n// Calculate Hue (in degrees 0-360)\r\nh = 0.0;\r\nif (delta > EPSILON) {\r\n    // Determine which channel is max\r\n    if (abs(cmax - r) < EPSILON) {\r\n        // Red is max\r\n        h = HUE_SECTOR_0 * (((g - b) / delta) % HUE_SECTORS);\r\n    }\r\n    else if (abs(cmax - g) < EPSILON) {\r\n        // Green is max\r\n        h = HUE_SECTOR_0 * (((b - r) / delta) + 2.0);\r\n    }\r\n    else {\r\n        // Blue is max\r\n        h = HUE_SECTOR_0 * (((r - g) / delta) + 4.0);\r\n    }\r\n}\r\n\r\n// Ensure hue is positive\r\nif (h < 0) {\r\n    h = h + 360.0;\r\n}\r\n\r\n// Calculate Saturation\r\ns = 0.0;\r\nif (cmax > EPSILON) {\r\n    s = delta / cmax;\r\n}\r\n\r\n// Value\r\nv = cmax;\r\n\r\n// Adjust saturation by factor and clamp\r\ns_adjusted = clamp(s * factor, 0.0, 1.0);\r\n\r\n// HSV to RGB conversion\r\nc = v * s_adjusted;\r\nx = c * (1.0 - abs(((h / HUE_SECTOR_0) % 2.0) - 1.0));\r\nm = v - c;\r\n\r\n// Determine RGB based on hue sector\r\nr_new = 0.0;\r\ng_new = 0.0;\r\nb_new = 0.0;\r\n\r\nif (h < HUE_SECTOR_0) {\r\n    // Sector 0: [0, 60)\r\n    r_new = c;\r\n    g_new = x;\r\n    b_new = 0.0;\r\n}\r\nelse if (h < HUE_SECTOR_1) {\r\n    // Sector 1: [60, 120)\r\n    r_new = x;\r\n    g_new = c;\r\n    b_new = 0.0;\r\n}\r\nelse if (h < HUE_SECTOR_2) {\r\n    // Sector 2: [120, 180)\r\n    r_new = 0.0;\r\n    g_new = c;\r\n    b_new = x;\r\n}\r\nelse if (h < HUE_SECTOR_3) {\r\n    // Sector 3: [180, 240)\r\n    r_new = 0.0;\r\n    g_new = x;\r\n    b_new = c;\r\n}\r\nelse if (h < HUE_SECTOR_4) {\r\n    // Sector 4: [240, 300)\r\n    r_new = x;\r\n    g_new = 0.0;\r\n    b_new = c;\r\n}\r\nelse {\r\n    // Sector 5: [300, 360)\r\n    r_new = c;\r\n    g_new = 0.0;\r\n    b_new = x;\r\n}\r\n\r\n// Add m to all channels and output with preserved alpha\r\nout1 = vec(r_new + m, g_new + m, b_new + m, a);",
					"fontname": "Arial",
