					"text": "param scale 1 1 20"
				}
			},
			{
				"box": {
					"code": "// Scale factor for Bayer pattern (1 = normal, higher = larger blocks)\nscale_int = max(1, int(scale));\n\npx = int(norm.x * dim.x);\npy = int(norm.y * dim.y);\n\n// Determine position in 2x2 Bayer pattern (scaled)\ncx = (px / scale_int) % 2;\ncy = (py / scale_int) % 2;\n\n// Read input RGB channels\nr = in1.r;\ng = in1.g;\nb = in1.b;\n\n// Extract appropriate channel based on pattern and position\nvalue = 0.0;\n\n// RGGB pattern (0)\nif (pattern == 0) {\n    if (cy == 0 && cx == 0) {\n        value = r;  // Top-left: R\n    } else if (cy == 0 && cx == 1) {\n        value = g;  // Top-right: G\n    } else if (cy == 1 && cx == 0) {\n        value = g;  // Bottom-left: G\n    } else {  // cy == 1 && cx == 1\n        value = b;  // Bottom-right: B\n    }\n}\n// BGGR pattern (1)\nelse if (pattern == 1) {\n    if (cy == 0 && cx == 0) {\n        value = b;  // Top-left: B\n    } else if (cy == 0 && cx == 1) {\n        value = g;  // Top-right: G\n    } else if (cy == 1 && cx == 0) {\n        value = g;  // Bottom-left: G\n    } else {  // cy == 1 && cx == 1\n        value = r;  // Bottom-right: R\n    }\n}\n// GRBG pattern (2)\nelse if (pattern == 2) {\n    if (cy == 0 && cx == 0) {\n        value = g;  // Top-left: G\n    } else if (cy == 0 && cx == 1) {\n        value = r;  // Top-right: R\n    } else if (cy == 1 && cx == 0) {\n        value = b;  // Bottom-left: B\n    } else {  // cy == 1 && cx == 1\n        value = g;  // Bottom-right: G\n    }\n}\n// GBRG pattern (3)\nelse {\n    if (cy == 0 && cx == 0) {\n        value = g;  // Top-left: G\n    } else if (cy == 0 && cx == 1) {\n        value = b;  // Top-right: B\n    } else if (cy == 1 && cx == 0) {\n        value = r;  // Bottom-left: R\n    } else {  // cy == 1 && cx == 1\n        value = g;  // Bottom-right: G\n    }\n}\n\n// Output as grayscale (stored in RGB for demosaic compatibility)\n// Store the extracted value in all channels so demosaic can read it\nout1 = vec(value, value, value, 1.0);",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "codebox",
					"numinlets": 1,
					"numoutlets": 1,
