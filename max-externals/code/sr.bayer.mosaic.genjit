					"text": "param pattern 0"
				}
			},
			{
				"box": {
					"code": "px = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Determine position in 2x2 Bayer pattern\r\ncx = px % 2;\r\ncy = py % 2;\r\n\r\n// Read input RGB channels\r\nr = in1.r;\r\ng = in1.g;\r\nb = in1.b;\r\n\r\n// Extract appropriate channel based on pattern and position\r\nvalue = 0.0;\r\n\r\n// RGGB pattern (0)\r\nif (pattern == 0) {\r\n    if (cy == 0 && cx == 0) {\r\n        value = r;  // Top-left: R\r\n    } else if (cy == 0 && cx == 1) {\r\n        value = g;  // Top-right: G\r\n    } else if (cy == 1 && cx == 0) {\r\n        value = g;  // Bottom-left: G\r\n    } else {  // cy == 1 && cx == 1\r\n        value = b;  // Bottom-right: B\r\n    }\r\n}\r\n// BGGR pattern (1)\r\nelse if (pattern == 1) {\r\n    if (cy == 0 && cx == 0) {\r\n        value = b;  // Top-left: B\r\n    } else if (cy == 0 && cx == 1) {\r\n        value = g;  // Top-right: G\r\n    } else if (cy == 1 && cx == 0) {\r\n        value = g;  // Bottom-left: G\r\n    } else {  // cy == 1 && cx == 1\r\n        value = r;  // Bottom-right: R\r\n    }\r\n}\r\n// GRBG pattern (2)\r\nelse if (pattern == 2) {\r\n    if (cy == 0 && cx == 0) {\r\n        value = g;  // Top-left: G\r\n    } else if (cy == 0 && cx == 1) {\r\n        value = r;  // Top-right: R\r\n    } else if (cy == 1 && cx == 0) {\r\n        value = b;  // Bottom-left: B\r\n    } else {  // cy == 1 && cx == 1\r\n        value = g;  // Bottom-right: G\r\n    }\r\n}\r\n// GBRG pattern (3)\r\nelse {\r\n    if (cy == 0 && cx == 0) {\r\n        value = g;  // Top-left: G\r\n    } else if (cy == 0 && cx == 1) {\r\n        value = b;  // Top-right: B\r\n    } else if (cy == 1 && cx == 0) {\r\n        value = r;  // Bottom-left: R\r\n    } else {  // cy == 1 && cx == 1\r\n        value = g;  // Bottom-right: G\r\n    }\r\n}\r\n\r\n// Output as grayscale (stored in RGB for demosaic compatibility)\r\n// Store the extracted value in all channels so demosaic can read it\r\nout = vec(value, value, value, 1.0);",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-3",
					"maxclass": "codebox",
