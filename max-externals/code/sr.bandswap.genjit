						30.0,
						100.0,
						20.0
					],
					"text": "param perm_b 2 0 2"
				}
			},
			{
				"box": {
					"code": "mask_value = sample(in2, norm).r;\r\n\r\n// If mask value > 0.5, this pixel is in a tile region\r\nif (mask_value > 0.5) {\r\n    // Read original RGB channels\r\n    r_in = in1.r;\r\n    g_in = in1.g;\r\n    b_in = in1.b;\r\n\r\n    // Create array-like access\r\n    channels = vec(r_in, g_in, b_in);\r\n\r\n    // Apply permutation\r\n    // Note: GenExpr doesn't support array indexing directly,\r\n    // so we use conditionals to select channels\r\n\r\n    // Select red output channel\r\n    r_out = (perm_r == 0) ? channels.r : ((perm_r == 1) ? channels.g : channels.b);\r\n\r\n    // Select green output channel\r\n    g_out = (perm_g == 0) ? channels.r : ((perm_g == 1) ? channels.g : channels.b);\r\n\r\n    // Select blue output channel\r\n    b_out = (perm_b == 0) ? channels.r : ((perm_b == 1) ? channels.g : channels.b);\r\n\r\n    // Output permuted channels, preserve alpha\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n} else {\r\n    // Outside tile region, pass through unchanged\r\n    out1 = in1;\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-6",
					"maxclass": "codebox",
					"numinlets": 2,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
