					"text": "param seed 0"
				}
			},
			{
				"box": {
					"code": "/*\r\n * sr.noise.genjit\r\n *\r\n * Adds random noise to image with three modes\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   mode (int 0-2): Noise type - 0=Gaussian per-pixel, 1=row, 2=column (default: 0)\r\n *   amount (float 0-1): Noise intensity (default: 0.1)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Mode 0: Per-pixel Gaussian noise via Box-Muller transform\r\n *   - Mode 1: Row noise (horizontal scanlines)\r\n *   - Mode 2: Column noise (vertical artifacts)\r\n *   - Uses GPU-friendly sin-based hash for deterministic randomness\r\n *\r\n * Source: src/sevenrad_stills/operations/noise_taichi.py\r\n */\r\n\r\n/*\r\n * GPU Hash Functions\r\n * Sin-based hash for GPU-friendly random number generation\r\n * Must be declared BEFORE all statements\r\n */\r\ngpu_hash(px, py, s) {\r\n    dot_val = px * 12.9898 + py * 78.233 + s * 43.758;\r\n    return fract(sin(dot_val) * 43758.5453);\r\n}\r\n\r\ngpu_hash2(px, py, s) {\r\n    dot_val = px * 93.989 + py * 67.345 + s * 28.462;\r\n    return fract(sin(dot_val) * 28462.6453);\r\n}\r\n\r\n// Constants\r\nTWO_PI = 6.283185307179586;\r\nEPSILON = 0.0000000001;\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// Mode 0: Gaussian noise (per-pixel)\r\nif (mode == 0) {\r\n    // Generate u1 and u2 for R channel (uncorrelated via different hash functions)\r\n    u1r = gpu_hash(px, py, seed);\r\n    u2r = gpu_hash2(px, py, seed);\r\n\r\n    // Box-Muller for R channel\r\n    u1r_safe = max(u1r, EPSILON);\r\n    mag_r = sqrt(-2.0 * log(u1r_safe));\r\n    noise_r = mag_r * cos(TWO_PI * u2r) * amount;\r\n\r\n    // Generate u1 and u2 for G channel\r\n    u1g = gpu_hash(px, py, seed + 1);\r\n    u2g = gpu_hash2(px, py, seed + 1);\r\n\r\n    // Box-Muller for G channel\r\n    u1g_safe = max(u1g, EPSILON);\r\n    mag_g = sqrt(-2.0 * log(u1g_safe));\r\n    noise_g = mag_g * cos(TWO_PI * u2g) * amount;\r\n\r\n    // Generate u1 and u2 for B channel\r\n    u1b = gpu_hash(px, py, seed + 2);\r\n    u2b = gpu_hash2(px, py, seed + 2);\r\n\r\n    // Box-Muller for B channel\r\n    u1b_safe = max(u1b, EPSILON);\r\n    mag_b = sqrt(-2.0 * log(u1b_safe));\r\n    noise_b = mag_b * cos(TWO_PI * u2b) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 1: Row noise (horizontal scanlines)\r\nelse if (mode == 1) {\r\n    // Generate random values for each channel (py-based for rows)\r\n    u_r = gpu_hash(py, 0, seed);\r\n    u_g = gpu_hash(py, 0, seed + 1);\r\n    u_b = gpu_hash(py, 0, seed + 2);\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 2: Column noise (vertical artifacts)\r\nelse {\r\n    // Generate random values for each channel (px-based for columns)\r\n    u_r = gpu_hash(0, px, seed);\r\n    u_g = gpu_hash(0, px, seed + 1);\r\n    u_b = gpu_hash(0, px, seed + 2);\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}",
					"fontname": "Arial",
