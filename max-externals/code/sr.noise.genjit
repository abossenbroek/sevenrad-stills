			},
			{
				"box": {
					"code": "PCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\nTWO_PI = 6.283185307179586;\r\nEPSILON = 0.0000000001;\r\n\r\n/**\r\n * PCG-derived hash function for generating pseudo-random values.\r\n *\r\n * @param input_seed Input seed value to hash\r\n * @return Hashed value as float in range [0.0, 1.0)\r\n */\r\npcg_hash(input_seed) {\r\n    // Cast to u32 to ensure correct Taichi-style arithmetic\r\n    state = int((uint(input_seed) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word = int(((state >> ((state >> 28) + 4)) ^ state) * uint(PCG_FACTOR));\r\n    hash_out = (word >> 22) ^ word;\r\n    return float(uint(hash_out)) / UINT32_MAX;\r\n}\r\n\r\n/**\r\n * Generate deterministic random float based on coordinates and seed.\r\n *\r\n * @param x X coordinate (column)\r\n * @param y Y coordinate (row)\r\n * @param s Random seed\r\n * @return Uniform random float in range [0.0, 1.0)\r\n */\r\nrand_float(x, y, s) {\r\n    combined = uint(x) * uint(COORD_PRIME_X) + uint(y) * uint(COORD_PRIME_Y) + uint(s);\r\n    return pcg_hash(combined);\r\n}\r\n\r\n/**\r\n * Generate Gaussian noise using Box-Muller transform.\r\n *\r\n * @param x X coordinate\r\n * @param y Y coordinate\r\n * @param s Random seed\r\n * @param sigma Standard deviation (amount)\r\n * @return Gaussian random value with mean=0, std=sigma\r\n */\r\nrand_gaussian(x, y, s, sigma) {\r\n    u1 = rand_float(x, y, s);\r\n    u2 = rand_float(x, y, s + 1);\r\n\r\n    // Avoid log(0)\r\n    u1_safe = max(u1, EPSILON);\r\n\r\n    // Box-Muller: z = sqrt(-2*ln(u1)) * cos(2*pi*u2)\r\n    mag = sqrt(-2.0 * log(u1_safe));\r\n    z = mag * cos(TWO_PI * u2);\r\n\r\n    return z * sigma;\r\n}\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// Mode 0: Gaussian noise (per-pixel)\r\nif (mode == 0) {\r\n    noise_r = rand_gaussian(px, py, seed, amount);\r\n    noise_g = rand_gaussian(px, py, seed + 1, amount);\r\n    noise_b = rand_gaussian(px, py, seed + 2, amount);\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 1: Row noise (horizontal scanlines)\r\nelse if (mode == 1) {\r\n    // Use py for row, x=0 for consistency across row\r\n    u_r = rand_float(py, 0, seed);\r\n    u_g = rand_float(py, 0, seed + 1);\r\n    u_b = rand_float(py, 0, seed + 2);\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 2: Column noise (vertical artifacts)\r\nelse {\r\n    // Use px for column, y=0 for consistency across column\r\n    u_r = rand_float(0, px, seed);\r\n    u_g = rand_float(0, px, seed + 1);\r\n    u_b = rand_float(0, px, seed + 2);\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}",
					"fontname": "Arial",
