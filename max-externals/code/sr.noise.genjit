			{
				"box": {
					"code": "/*\r\n * sr.noise.genjit\r\n *\r\n * Adds random noise to image with three modes\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   mode (int 0-2): Noise type - 0=Gaussian per-pixel, 1=row, 2=column (default: 0)\r\n *   amount (float 0-1): Noise intensity (default: 0.1)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Mode 0: Per-pixel Gaussian noise via Box-Muller transform\r\n *   - Mode 1: Row noise (horizontal scanlines)\r\n *   - Mode 2: Column noise (vertical artifacts)\r\n *   - Uses PCG hash for deterministic randomness\r\n *\r\n * Source: src/sevenrad_stills/operations/noise_taichi.py\r\n */\r\n\r\n// PCG hash constants (must match Python/Taichi)\r\nPCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\nTWO_PI = 6.283185307179586;\r\nEPSILON = 0.0000000001;\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// Mode 0: Gaussian noise (per-pixel)\r\nif (mode == 0) {\r\n    // Generate u1 for R channel: rand_float(px, py, seed)\r\n    combined_u1r = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed);\r\n    state_u1r = int((uint(combined_u1r) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u1r = int(((state_u1r >> ((state_u1r >> 28) + 4)) ^ state_u1r) * uint(PCG_FACTOR));\r\n    hash_u1r = (word_u1r >> 22) ^ word_u1r;\r\n    u1r = float(uint(hash_u1r)) / UINT32_MAX;\r\n\r\n    // Generate u2 for R channel: rand_float(px, py, seed + 1)\r\n    combined_u2r = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 1);\r\n    state_u2r = int((uint(combined_u2r) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u2r = int(((state_u2r >> ((state_u2r >> 28) + 4)) ^ state_u2r) * uint(PCG_FACTOR));\r\n    hash_u2r = (word_u2r >> 22) ^ word_u2r;\r\n    u2r = float(uint(hash_u2r)) / UINT32_MAX;\r\n\r\n    // Box-Muller for R channel\r\n    u1r_safe = max(u1r, EPSILON);\r\n    mag_r = sqrt(-2.0 * log(u1r_safe));\r\n    noise_r = mag_r * cos(TWO_PI * u2r) * amount;\r\n\r\n    // Generate u1 for G channel: rand_float(px, py, seed + 2)\r\n    combined_u1g = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 2);\r\n    state_u1g = int((uint(combined_u1g) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u1g = int(((state_u1g >> ((state_u1g >> 28) + 4)) ^ state_u1g) * uint(PCG_FACTOR));\r\n    hash_u1g = (word_u1g >> 22) ^ word_u1g;\r\n    u1g = float(uint(hash_u1g)) / UINT32_MAX;\r\n\r\n    // Generate u2 for G channel: rand_float(px, py, seed + 3)\r\n    combined_u2g = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 3);\r\n    state_u2g = int((uint(combined_u2g) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u2g = int(((state_u2g >> ((state_u2g >> 28) + 4)) ^ state_u2g) * uint(PCG_FACTOR));\r\n    hash_u2g = (word_u2g >> 22) ^ word_u2g;\r\n    u2g = float(uint(hash_u2g)) / UINT32_MAX;\r\n\r\n    // Box-Muller for G channel\r\n    u1g_safe = max(u1g, EPSILON);\r\n    mag_g = sqrt(-2.0 * log(u1g_safe));\r\n    noise_g = mag_g * cos(TWO_PI * u2g) * amount;\r\n\r\n    // Generate u1 for B channel: rand_float(px, py, seed + 4)\r\n    combined_u1b = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 4);\r\n    state_u1b = int((uint(combined_u1b) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u1b = int(((state_u1b >> ((state_u1b >> 28) + 4)) ^ state_u1b) * uint(PCG_FACTOR));\r\n    hash_u1b = (word_u1b >> 22) ^ word_u1b;\r\n    u1b = float(uint(hash_u1b)) / UINT32_MAX;\r\n\r\n    // Generate u2 for B channel: rand_float(px, py, seed + 5)\r\n    combined_u2b = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed + 5);\r\n    state_u2b = int((uint(combined_u2b) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_u2b = int(((state_u2b >> ((state_u2b >> 28) + 4)) ^ state_u2b) * uint(PCG_FACTOR));\r\n    hash_u2b = (word_u2b >> 22) ^ word_u2b;\r\n    u2b = float(uint(hash_u2b)) / UINT32_MAX;\r\n\r\n    // Box-Muller for B channel\r\n    u1b_safe = max(u1b, EPSILON);\r\n    mag_b = sqrt(-2.0 * log(u1b_safe));\r\n    noise_b = mag_b * cos(TWO_PI * u2b) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 1: Row noise (horizontal scanlines)\r\nelse if (mode == 1) {\r\n    // R channel: rand_float(py, 0, seed)\r\n    combined_r = uint(py) * uint(COORD_PRIME_X) + uint(0) * uint(COORD_PRIME_Y) + uint(seed);\r\n    state_r = int((uint(combined_r) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_r = int(((state_r >> ((state_r >> 28) + 4)) ^ state_r) * uint(PCG_FACTOR));\r\n    hash_r = (word_r >> 22) ^ word_r;\r\n    u_r = float(uint(hash_r)) / UINT32_MAX;\r\n\r\n    // G channel: rand_float(py, 0, seed + 1)\r\n    combined_g = uint(py) * uint(COORD_PRIME_X) + uint(0) * uint(COORD_PRIME_Y) + uint(seed + 1);\r\n    state_g = int((uint(combined_g) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_g = int(((state_g >> ((state_g >> 28) + 4)) ^ state_g) * uint(PCG_FACTOR));\r\n    hash_g = (word_g >> 22) ^ word_g;\r\n    u_g = float(uint(hash_g)) / UINT32_MAX;\r\n\r\n    // B channel: rand_float(py, 0, seed + 2)\r\n    combined_b = uint(py) * uint(COORD_PRIME_X) + uint(0) * uint(COORD_PRIME_Y) + uint(seed + 2);\r\n    state_b = int((uint(combined_b) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_b = int(((state_b >> ((state_b >> 28) + 4)) ^ state_b) * uint(PCG_FACTOR));\r\n    hash_b = (word_b >> 22) ^ word_b;\r\n    u_b = float(uint(hash_b)) / UINT32_MAX;\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}\r\n// Mode 2: Column noise (vertical artifacts)\r\nelse {\r\n    // R channel: rand_float(0, px, seed)\r\n    combined_r = uint(0) * uint(COORD_PRIME_X) + uint(px) * uint(COORD_PRIME_Y) + uint(seed);\r\n    state_r = int((uint(combined_r) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_r = int(((state_r >> ((state_r >> 28) + 4)) ^ state_r) * uint(PCG_FACTOR));\r\n    hash_r = (word_r >> 22) ^ word_r;\r\n    u_r = float(uint(hash_r)) / UINT32_MAX;\r\n\r\n    // G channel: rand_float(0, px, seed + 1)\r\n    combined_g = uint(0) * uint(COORD_PRIME_X) + uint(px) * uint(COORD_PRIME_Y) + uint(seed + 1);\r\n    state_g = int((uint(combined_g) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_g = int(((state_g >> ((state_g >> 28) + 4)) ^ state_g) * uint(PCG_FACTOR));\r\n    hash_g = (word_g >> 22) ^ word_g;\r\n    u_g = float(uint(hash_g)) / UINT32_MAX;\r\n\r\n    // B channel: rand_float(0, px, seed + 2)\r\n    combined_b = uint(0) * uint(COORD_PRIME_X) + uint(px) * uint(COORD_PRIME_Y) + uint(seed + 2);\r\n    state_b = int((uint(combined_b) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_b = int(((state_b >> ((state_b >> 28) + 4)) ^ state_b) * uint(PCG_FACTOR));\r\n    hash_b = (word_b >> 22) ^ word_b;\r\n    u_b = float(uint(hash_b)) / UINT32_MAX;\r\n\r\n    // Map [0,1] to [-amount, amount]\r\n    noise_r = (u_r * 2.0 - 1.0) * amount;\r\n    noise_g = (u_g * 2.0 - 1.0) * amount;\r\n    noise_b = (u_b * 2.0 - 1.0) * amount;\r\n\r\n    r_out = clamp(in1.r + noise_r, 0, 1);\r\n    g_out = clamp(in1.g + noise_g, 0, 1);\r\n    b_out = clamp(in1.b + noise_b, 0, 1);\r\n\r\n    out1 = vec(r_out, g_out, b_out, in1.a);\r\n}",
					"fontname": "Arial",
