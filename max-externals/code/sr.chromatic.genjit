				}
			},
			{
				"box": {
					"code": "/*\r\n * sr.chromatic.genjit\r\n *\r\n * Chromatic aberration color fringing effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   shift_x (float): Horizontal shift amount in pixels (default: 5.0)\r\n *   shift_y (float): Vertical shift amount in pixels (default: 0.0)\r\n *\r\n * Algorithm:\r\n *   - Shifts red channel by +shift, blue by -shift\r\n *   - Green channel remains at original position\r\n *   - Creates classic chromatic aberration effect\r\n *\r\n * Source: Python chromatic aberration implementation\r\n */\r\n\r\n// Calculate normalized shift from pixel shift values\r\nshift = vec(shift_x / dim.x, shift_y / dim.y);\r\n\r\n// Sample red channel with positive shift\r\nr = sample(in1, norm + shift).r;\r\n\r\n// Sample green channel at original position (reference)\r\ng = sample(in1, norm).g;\r\n\r\n// Sample blue channel with negative shift\r\nb = sample(in1, norm - shift).b;\r\n\r\n// Preserve original alpha\r\na = sample(in1, norm).a;\r\n\r\n// Output combined chromatic aberration\r\nout1 = vec(r, g, b, a);",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-4",
					"maxclass": "codebox",
					"numinlets": 1,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						50.0,
						120.0,
						500.0,
						340.0
					]
				}
			},
