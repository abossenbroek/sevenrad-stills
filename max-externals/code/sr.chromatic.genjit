					"text": "in 1"
				}
			},
			{
				"box": {
					"code": "<jit.gl.pix>\r\n<description>Chromatic aberration color fringing effect</description>\r\n\r\n<param name=\"shift_x\" type=\"float\" default=\"5.0\" />\r\n<param name=\"shift_y\" type=\"float\" default=\"0.0\" />\r\n\r\n<language name=\"glsl\" version=\"1.2\">\r\n<bind param=\"shift_x\" program=\"fp\" />\r\n<bind param=\"shift_y\" program=\"fp\" />\r\n\r\n<program name=\"fp\" type=\"fragment\">\r\n<![CDATA[\r\n\r\n#version 120\r\n\r\nuniform sampler2DRect tex0;\r\nuniform vec2 texdim0;\r\nuniform float shift_x;\r\nuniform float shift_y;\r\n\r\nvarying vec2 texcoord0;\r\n\r\nvoid main() {\r\n    // Calculate normalized shift\r\n    vec2 shift = vec2(shift_x, shift_y);\r\n\r\n    // Sample red channel with positive shift\r\n    vec2 red_coord = texcoord0 + shift;\r\n    float r = texture2DRect(tex0, red_coord).r;\r\n\r\n    // Sample green channel with no shift (reference)\r\n    float g = texture2DRect(tex0, texcoord0).g;\r\n\r\n    // Sample blue channel with negative shift\r\n    vec2 blue_coord = texcoord0 - shift;\r\n    float b = texture2DRect(tex0, blue_coord).b;\r\n\r\n    // Preserve original alpha\r\n    float a = texture2DRect(tex0, texcoord0).a;\r\n\r\n    gl_FragColor = vec4(r, g, b, a);\r\n}\r\n\r\n]]>\r\n</program>\r\n</language>\r\n</jit.gl.pix>",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-2",
					"maxclass": "codebox",
					"numinlets": 1,
					"numoutlets": 1,
					"outlettype": [
						""
					],
					"patching_rect": [
						50.0,
						120.0,
						500.0,
						340.0
					]
				}
