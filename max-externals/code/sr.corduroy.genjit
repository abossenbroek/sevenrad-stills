			{
				"box": {
					"code": "/*\r\n * sr.corduroy.genjit\r\n *\r\n * Corduroy stripe brightness variation effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   orientation (int 0-1): 0 = vertical stripes, 1 = horizontal (default: 0)\r\n *   strength (float 0-1): Intensity of brightness variation (default: 0.3)\r\n *   density (float 0-1): Proportion of lines affected (default: 0.2)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Uses PCG hash for deterministic per-line randomness\r\n *   - Applies brightness multiplier to affected lines\r\n *   - Creates subtle vertical/horizontal stripe texture\r\n *\r\n * Source: src/sevenrad_stills/operations/corduroy_taichi.py\r\n */\r\n\r\n// PCG hash constants (must match Python/Taichi)\r\nPCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Select line index based on orientation\r\n// 0 = vertical stripes, 1 = horizontal stripes\r\nline_idx = (orientation == 0) ? px : py;\r\n\r\n// Inline PCG hash for r_density: rand_line(line_idx, 0, seed)\r\ncombined_d = uint(line_idx) * uint(COORD_PRIME_X) + uint(0) * uint(COORD_PRIME_Y) + uint(seed);\r\nstate_d = int((uint(combined_d) * uint(PCG_MULT) + uint(PCG_INC)));\r\nword_d = int(((state_d >> ((state_d >> 28) + 4)) ^ state_d) * uint(PCG_FACTOR));\r\nhash_d = (word_d >> 22) ^ word_d;\r\nr_density = float(uint(hash_d)) / UINT32_MAX;\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// Apply corduroy effect if this line is affected\r\nif (r_density < density) {\r\n    // Inline PCG hash for r_mult: rand_line(line_idx, 1, seed)\r\n    combined_m = uint(line_idx) * uint(COORD_PRIME_X) + uint(1) * uint(COORD_PRIME_Y) + uint(seed);\r\n    state_m = int((uint(combined_m) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word_m = int(((state_m >> ((state_m >> 28) + 4)) ^ state_m) * uint(PCG_FACTOR));\r\n    hash_m = (word_m >> 22) ^ word_m;\r\n    r_mult = float(uint(hash_m)) / UINT32_MAX;\r\n\r\n    // Map [0, 1) to [1 - strength*0.2, 1 + strength*0.2]\r\n    mult = 1.0 + (r_mult - 0.5) * strength * 0.4;\r\n\r\n    // Apply multiplier to RGB channels, preserve alpha\r\n    r_new = clamp(in1.r * mult, 0, 1);\r\n    g_new = clamp(in1.g * mult, 0, 1);\r\n    b_new = clamp(in1.b * mult, 0, 1);\r\n\r\n    out1 = vec(r_new, g_new, b_new, in1.a);\r\n}",
					"fontname": "Arial",
