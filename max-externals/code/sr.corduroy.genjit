/**
 * sr.corduroy.genjit
 *
 * Corduroy striping effect for jit.gl.pix (GenExpr shader)
 *
 * Simulates "corduroy" or "banding" artifacts from push-broom/whisk-broom
 * scanners where individual detector elements have slightly different
 * sensitivity due to calibration drift or manufacturing variations.
 *
 * Parameters:
 *   orientation (int 0-1): 0=vertical stripes, 1=horizontal stripes
 *   strength (float 0.0-1.0): stripe intensity variation
 *   density (float 0.0-1.0): fraction of lines affected
 *   seed (int): random seed for reproducibility
 *
 * Usage in Max:
 *   [jit.gl.pix @gen sr.corduroy]
 *   Send messages: orientation 0, strength 0.3, density 0.2, seed 42
 */

// Parameter declarations
Param orientation(0);
Param strength(0.3);
Param density(0.2);
Param seed(0);

// PCG hash constants (must match Python implementation exactly)
PCG_MULT = 747796405;
PCG_INC = 2891336453;
PCG_FACTOR = 277803737;
COORD_PRIME_X = 374761393;
COORD_PRIME_Y = 668265263;
UINT32_MAX = 4294967296.0;

/**
 * PCG-derived hash function for generating pseudo-random values.
 *
 * @param input_seed Input seed value to hash
 * @return Hashed value as float in range [0.0, 1.0)
 */
pcg_hash(input_seed) {
    // Cast to u32 to ensure correct Taichi-style arithmetic
    state = int((uint(input_seed) * uint(PCG_MULT) + uint(PCG_INC)));
    word = int(((state >> ((state >> 28) + 4)) ^ state) * uint(PCG_FACTOR));
    hash_out = (word >> 22) ^ word;
    return float(uint(hash_out)) / UINT32_MAX;
}

/**
 * Generate deterministic random float based on line index and seed.
 *
 * @param line_idx Line index (row or column number)
 * @param channel Channel offset (for independent per-channel randomness)
 * @param s Random seed
 * @return Uniform random float in range [0.0, 1.0)
 */
rand_line(line_idx, channel, s) {
    combined = uint(line_idx) * uint(COORD_PRIME_X) + uint(channel) * uint(COORD_PRIME_Y) + uint(s);
    return pcg_hash(combined);
}

// Get current pixel coordinates
px = int(norm.x * dim.x);
py = int(norm.y * dim.y);

// Select line index based on orientation
// 0 = vertical stripes (same multiplier per column)
// 1 = horizontal stripes (same multiplier per row)
line_idx = (orientation == 0) ? px : py;

// Check if this line is affected by corduroy
// Use line_idx and seed to generate deterministic random value
r_density = rand_line(line_idx, 0, seed);

// Default: pass through unchanged
out = in1;

// Apply corduroy effect if this line is affected
if (r_density < density) {
    // Generate brightness multiplier for this line
    // Range: [1.0 - strength*0.2, 1.0 + strength*0.2]
    // This matches STRENGTH_SCALE = 0.2 from Python implementation
    r_mult = rand_line(line_idx, 1, seed);

    // Map [0, 1) to [1 - strength*0.2, 1 + strength*0.2]
    // r_mult in [0, 1) -> (r_mult - 0.5) in [-0.5, 0.5)
    // -> (r_mult - 0.5) * strength * 0.4 in [-strength*0.2, strength*0.2)
    // -> 1.0 + ... in [1-strength*0.2, 1+strength*0.2)
    mult = 1.0 + (r_mult - 0.5) * strength * 0.4;

    // Apply multiplier to RGB channels, preserve alpha
    r_new = clamp(in1.r * mult, 0, 1);
    g_new = clamp(in1.g * mult, 0, 1);
    b_new = clamp(in1.b * mult, 0, 1);

    out = vec(r_new, g_new, b_new, in1.a);
}
