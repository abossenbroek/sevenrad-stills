			{
				"box": {
					"code": "PCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\n\r\n/**\r\n * PCG-derived hash function for generating pseudo-random values.\r\n *\r\n * @param input_seed Input seed value to hash\r\n * @return Hashed value as float in range [0.0, 1.0)\r\n */\r\npcg_hash(input_seed) {\r\n    // Cast to u32 to ensure correct Taichi-style arithmetic\r\n    state = int((uint(input_seed) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word = int(((state >> ((state >> 28) + 4)) ^ state) * uint(PCG_FACTOR));\r\n    hash_out = (word >> 22) ^ word;\r\n    return float(uint(hash_out)) / UINT32_MAX;\r\n}\r\n\r\n/**\r\n * Generate deterministic random float based on line index and seed.\r\n *\r\n * @param line_idx Line index (row or column number)\r\n * @param channel Channel offset (for independent per-channel randomness)\r\n * @param s Random seed\r\n * @return Uniform random float in range [0.0, 1.0)\r\n */\r\nrand_line(line_idx, channel, s) {\r\n    combined = uint(line_idx) * uint(COORD_PRIME_X) + uint(channel) * uint(COORD_PRIME_Y) + uint(s);\r\n    return pcg_hash(combined);\r\n}\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Select line index based on orientation\r\n// 0 = vertical stripes (same multiplier per column)\r\n// 1 = horizontal stripes (same multiplier per row)\r\nline_idx = (orientation == 0) ? px : py;\r\n\r\n// Check if this line is affected by corduroy\r\n// Use line_idx and seed to generate deterministic random value\r\nr_density = rand_line(line_idx, 0, seed);\r\n\r\n// Default: pass through unchanged\r\nout = in1;\r\n\r\n// Apply corduroy effect if this line is affected\r\nif (r_density < density) {\r\n    // Generate brightness multiplier for this line\r\n    // Range: [1.0 - strength*0.2, 1.0 + strength*0.2]\r\n    // This matches STRENGTH_SCALE = 0.2 from Python implementation\r\n    r_mult = rand_line(line_idx, 1, seed);\r\n\r\n    // Map [0, 1) to [1 - strength*0.2, 1 + strength*0.2]\r\n    // r_mult in [0, 1) -> (r_mult - 0.5) in [-0.5, 0.5)\r\n    // -> (r_mult - 0.5) * strength * 0.4 in [-strength*0.2, strength*0.2)\r\n    // -> 1.0 + ... in [1-strength*0.2, 1+strength*0.2)\r\n    mult = 1.0 + (r_mult - 0.5) * strength * 0.4;\r\n\r\n    // Apply multiplier to RGB channels, preserve alpha\r\n    r_new = clamp(in1.r * mult, 0, 1);\r\n    g_new = clamp(in1.g * mult, 0, 1);\r\n    b_new = clamp(in1.b * mult, 0, 1);\r\n\r\n    out = vec(r_new, g_new, b_new, in1.a);\r\n}",
					"fontname": "Arial",
