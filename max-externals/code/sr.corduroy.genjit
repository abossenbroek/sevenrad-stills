			},
			{
				"box": {
					"code": "/*\r\n * sr.corduroy.genjit\r\n *\r\n * Corduroy stripe brightness variation effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   orientation (int 0-1): 0 = vertical stripes, 1 = horizontal (default: 0)\r\n *   strength (float 0-1): Intensity of brightness variation (default: 0.3)\r\n *   density (float 0-1): Proportion of lines affected (default: 0.2)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Uses GPU-friendly sin-based hash for deterministic per-line randomness\r\n *   - Applies brightness multiplier to affected lines\r\n *   - Creates subtle vertical/horizontal stripe texture\r\n *\r\n * Source: src/sevenrad_stills/operations/corduroy_taichi.py\r\n */\r\n\r\n/*\r\n * GPU Hash Function\r\n * Sin-based hash for GPU-friendly random number generation\r\n * Must be declared BEFORE all statements\r\n */\r\ngpu_hash(px, py, s) {\r\n    dot_val = px * 12.9898 + py * 78.233 + s * 43.758;\r\n    return fract(sin(dot_val) * 43758.5453);\r\n}\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Select line index based on orientation\r\n// 0 = vertical stripes, 1 = horizontal stripes\r\nline_idx = (orientation == 0) ? px : py;\r\n\r\n// Use gpu_hash for deterministic per-line randomness\r\n// For line-based randomization, use line_idx as primary coordinate\r\nr_density = gpu_hash(line_idx, 0, seed);\r\n\r\n// Default: pass through unchanged\r\nout1 = in1;\r\n\r\n// Apply corduroy effect if this line is affected\r\nif (r_density < density) {\r\n    // Second random value for brightness multiplier (different seed offset)\r\n    r_mult = gpu_hash(line_idx, 1, seed);\r\n\r\n    // Map [0, 1) to [1 - strength*0.2, 1 + strength*0.2]\r\n    mult = 1.0 + (r_mult - 0.5) * strength * 0.4;\r\n\r\n    // Apply multiplier to RGB channels, preserve alpha\r\n    r_new = clamp(in1.r * mult, 0, 1);\r\n    g_new = clamp(in1.g * mult, 0, 1);\r\n    b_new = clamp(in1.b * mult, 0, 1);\r\n\r\n    out1 = vec(r_new, g_new, b_new, in1.a);\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
