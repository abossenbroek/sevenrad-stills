			{
				"box": {
					"code": "/*\r\n * sr.saltpepper.genjit\r\n *\r\n * Salt and pepper noise effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   amount (float 0-1): Proportion of pixels affected (default: 0.05)\r\n *   salt_ratio (float 0-1): Ratio of salt (white) to pepper (black) (default: 0.5)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Uses PCG hash for deterministic per-pixel randomness\r\n *   - Generates two random values per pixel\r\n *   - First determines if pixel is affected (based on amount)\r\n *   - Second determines if salt (white) or pepper (black) (based on salt_ratio)\r\n *\r\n * Source: src/sevenrad_stills/operations/saltpepper_taichi.py\r\n */\r\n\r\n// PCG hash constants (must match Python/Taichi)\r\nPCG_MULT = 747796405;\r\nPCG_INC = 2891336453;\r\nPCG_FACTOR = 277803737;\r\nCOORD_PRIME_X = 374761393;\r\nCOORD_PRIME_Y = 668265263;\r\nUINT32_MAX = 4294967296.0;\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Sample original pixel\r\noriginal = sample(in1, norm);\r\n\r\n// Inline PCG hash for rand1: random(px, py, seed)\r\ncombined1 = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed);\r\nstate1 = int((uint(combined1) * uint(PCG_MULT) + uint(PCG_INC)));\r\nword1 = int(((state1 >> ((state1 >> 28) + 4)) ^ state1) * uint(PCG_FACTOR));\r\nhash1 = (word1 >> 22) ^ word1;\r\nrand1 = float(uint(hash1)) / UINT32_MAX;\r\n\r\n// Default: pass through unchanged\r\nout1 = original;\r\n\r\n// Check if this pixel should be affected\r\nif (rand1 < amount) {\r\n    // Inline PCG hash for rand2: random(px, py, seed + 1)\r\n    combined2 = uint(px) * uint(COORD_PRIME_X) + uint(py) * uint(COORD_PRIME_Y) + uint(seed) + uint(1);\r\n    state2 = int((uint(combined2) * uint(PCG_MULT) + uint(PCG_INC)));\r\n    word2 = int(((state2 >> ((state2 >> 28) + 4)) ^ state2) * uint(PCG_FACTOR));\r\n    hash2 = (word2 >> 22) ^ word2;\r\n    rand2 = float(uint(hash2)) / UINT32_MAX;\r\n\r\n    // Determine if salt (white) or pepper (black)\r\n    if (rand2 < salt_ratio) {\r\n        // Salt: white pixel, preserve alpha\r\n        out1 = vec(1.0, 1.0, 1.0, original.a);\r\n    } else {\r\n        // Pepper: black pixel, preserve alpha\r\n        out1 = vec(0.0, 0.0, 0.0, original.a);\r\n    }\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
