					"text": "param seed 0 0 1000"
				}
			},
			{
				"box": {
					"code": "/*\r\n * sr.saltpepper.genjit\r\n *\r\n * Salt and pepper noise effect\r\n * Part of SevenRad Max 8 Effects\r\n *\r\n * Parameters:\r\n *   amount (float 0-1): Proportion of pixels affected (default: 0.05)\r\n *   salt_ratio (float 0-1): Ratio of salt (white) to pepper (black) (default: 0.5)\r\n *   seed (int): Random seed for deterministic results (default: 0)\r\n *\r\n * Algorithm:\r\n *   - Uses GPU-friendly sin-based hash for deterministic per-pixel randomness\r\n *   - Generates two random values per pixel\r\n *   - First determines if pixel is affected (based on amount)\r\n *   - Second determines if salt (white) or pepper (black) (based on salt_ratio)\r\n *\r\n * Source: src/sevenrad_stills/operations/saltpepper_taichi.py\r\n */\r\n\r\n/*\r\n * GPU Hash Function\r\n * Sin-based hash for GPU-friendly random number generation\r\n * Must be declared BEFORE all statements\r\n */\r\ngpu_hash(px, py, s) {\r\n    dot_val = px * 12.9898 + py * 78.233 + s * 43.758;\r\n    return fract(sin(dot_val) * 43758.5453);\r\n}\r\n\r\n// Get current pixel coordinates\r\npx = int(norm.x * dim.x);\r\npy = int(norm.y * dim.y);\r\n\r\n// Sample original pixel\r\noriginal = sample(in1, norm);\r\n\r\n// Generate random value to determine if pixel is affected\r\nrand1 = gpu_hash(px, py, seed);\r\n\r\n// Default: pass through unchanged\r\nout1 = original;\r\n\r\n// Check if this pixel should be affected\r\nif (rand1 < amount) {\r\n    // Generate second random value to determine salt vs pepper\r\n    rand2 = gpu_hash(px, py, seed + 1);\r\n\r\n    // Determine if salt (white) or pepper (black)\r\n    if (rand2 < salt_ratio) {\r\n        // Salt: white pixel, preserve alpha\r\n        out1 = vec(1.0, 1.0, 1.0, original.a);\r\n    } else {\r\n        // Pepper: black pixel, preserve alpha\r\n        out1 = vec(0.0, 0.0, 0.0, original.a);\r\n    }\r\n}",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-5",
