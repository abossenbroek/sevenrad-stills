					"text": "in 1"
				}
			},
			{
				"box": {
					"code": "<jit.gl.pix>\r\n<description>Salt and pepper noise effect</description>\r\n\r\n<param name=\"amount\" type=\"float\" default=\"0.05\" />\r\n<param name=\"salt_ratio\" type=\"float\" default=\"0.5\" />\r\n<param name=\"seed\" type=\"int\" default=\"0\" />\r\n\r\n<language name=\"glsl\" version=\"1.2\">\r\n<bind param=\"amount\" program=\"fp\" />\r\n<bind param=\"salt_ratio\" program=\"fp\" />\r\n<bind param=\"seed\" program=\"fp\" />\r\n\r\n<program name=\"fp\" type=\"fragment\">\r\n<![CDATA[\r\n\r\n#version 120\r\n\r\nuniform sampler2DRect tex0;\r\nuniform vec2 texdim0;\r\nuniform float amount;\r\nuniform float salt_ratio;\r\nuniform float seed;\r\n\r\nvarying vec2 texcoord0;\r\n\r\n// PCG hash constants (cast to uint in shader)\r\nconst uint PCG_MULT = 747796405u;\r\nconst uint PCG_INC = 2891336453u;\r\nconst uint PCG_FACTOR = 277803737u;\r\nconst uint COORD_PRIME_X = 374761393u;\r\nconst uint COORD_PRIME_Y = 668265263u;\r\n\r\n// PCG hash function for deterministic random generation\r\nuint pcg_hash(uint state) {\r\n    state = state * PCG_MULT + PCG_INC;\r\n    state ^= state >> 16u;\r\n    state *= PCG_FACTOR;\r\n    state ^= state >> 16u;\r\n    return state;\r\n}\r\n\r\n// Generate random float [0, 1] from pixel coordinates\r\nfloat random(vec2 coord, uint iseed) {\r\n    // Convert coordinates to integers and combine with seed\r\n    uint x = uint(coord.x);\r\n    uint y = uint(coord.y);\r\n\r\n    // Mix coordinates with primes and seed\r\n    uint state = iseed;\r\n    state ^= x * COORD_PRIME_X;\r\n    state ^= y * COORD_PRIME_Y;\r\n\r\n    // Generate random value\r\n    state = pcg_hash(state);\r\n\r\n    // Convert to [0, 1] range\r\n    return float(state) / 4294967295.0;\r\n}\r\n\r\nvoid main() {\r\n    vec4 original = texture2DRect(tex0, texcoord0);\r\n    uint iseed = uint(seed);\r\n\r\n    // Generate two independent random values\r\n    float rand1 = random(texcoord0, iseed);\r\n    float rand2 = random(texcoord0, iseed + 1u);\r\n\r\n    // Check if this pixel should be affected\r\n    if (rand1 < amount) {\r\n        // Determine if salt (white) or pepper (black)\r\n        if (rand2 < salt_ratio) {\r\n            // Salt: white pixel\r\n            gl_FragColor = vec4(1.0, 1.0, 1.0, original.a);\r\n        } else {\r\n            // Pepper: black pixel\r\n            gl_FragColor = vec4(0.0, 0.0, 0.0, original.a);\r\n        }\r\n    } else {\r\n        // Keep original pixel\r\n        gl_FragColor = original;\r\n    }\r\n}\r\n\r\n]]>\r\n</program>\r\n</language>\r\n</jit.gl.pix>",
					"fontname": "Arial",
					"fontsize": 12.0,
					"id": "obj-2",
